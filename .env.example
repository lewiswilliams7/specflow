# App (Supabase project "specflow", London). The publishable key is safe in the browser; row level security protects data.
NEXT_PUBLIC_SUPABASE_URL=https://ddvemrbnibhcvcyiyjzv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_rdU6QgS9Kdc9sO1gXhP4NA_moxYI4EQ
# 32 random bytes, base64. Encrypts Halo client secrets. Generate once, keep it safe: losing it means reconnecting every instance.
APP_ENCRYPTION_KEY=
# Planner model: one of these. PLANNER_MODEL optional (default gpt-5 / claude-sonnet-5-5).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PLANNER_MODEL=
# Optional: reasoning effort for follow-up replies (default low; the plan already exists). OPENAI_BASE_URL for Azure or a proxy.
PLANNER_REVISE_EFFORT=
OPENAI_BASE_URL=

# Pilot applications (app/api/pilot). Without these the form still works locally and logs instead.
# Supabase: project URL and the service role key (server only, never exposed to the browser).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Resend: emails you each new application.
RESEND_API_KEY=
PILOT_NOTIFY_EMAIL=
PILOT_FROM_EMAIL=
